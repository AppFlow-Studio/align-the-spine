# Production origin used for canonical URLs, the sitemap, robots.txt, and
# JSON-LD. REQUIRED in production — content/site.ts's resolveSiteUrl() throws
# at module load if this is unset and VERCEL_ENV=production, rather than
# silently falling back to the wrong domain. Outside production (local dev,
# CI, preview builds without this set) it falls back to
# https://chirobackpain.com, this site's real domain — not the legacy
# alignthespinechiropractic.com site, which is a separate deployment.
SITE_URL=https://chirobackpain.com

# Google Search Console HTML-tag verification token (Settings > Ownership
# verification > HTML tag > content="..."). Optional — app/layout.tsx omits
# the verification meta tag entirely when this is unset, so it's safe to
# ship without one until marketing supplies it.
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). lib/analytics.ts's helpers no-op
# until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking — both required together to fire the
# "conversion" event on a lead submit (lib/analytics.ts's trackLeadConversion).
# Find these in Google Ads under Goals > Conversions > your conversion action
# > "Tag setup" > "Use Google tag" (ID is the AW-XXXXXXXXX value, label is
# the string after the slash in the provided send_to).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Enables Enhanced Conversions for Leads (sends a lead's email/phone to
# gtag.js's `user_data`, which Google hashes client-side before
# transmission — this codebase never hashes or stores the raw values).
# Turn this on only after enabling Enhanced Conversions for this conversion
# action in Google Ads (Conversions > your action > "Enhanced conversions" >
# "Google tag" method) — sending user_data before that is a harmless no-op,
# so there's no rush to flip this the moment it's added.
NEXT_PUBLIC_GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# The client's own Google Tag Manager container ID (e.g. GTM-XXXXXXX),
# installed verbatim per their install instructions — independent of the
# direct GA4/Ads gtag.js install above.
NEXT_PUBLIC_GTM_ID=

# ATS-E5: durable lead persistence (lib/supabase-admin.ts, lib/lead-store.ts).
# Supabase project URL, e.g. https://<project-ref>.supabase.co (Settings >
# General > Project ID — combine with ".supabase.co").
SUPABASE_URL=
# Supabase Settings > API Keys > service_role (the SECRET key, not `anon`/
# `publishable`). Bypasses Row Level Security — server-only, must never be
# exposed as a NEXT_PUBLIC_* var or committed. content/site.ts-style: the
# app throws at first use if this is unset rather than silently degrading,
# so a misconfigured deploy fails loudly instead of losing leads.
SUPABASE_SERVICE_ROLE_KEY=

# ATS-E5/ATS-031: lead notification delivery (lib/lead-delivery.ts). Get an
# API key at resend.com — local/dev runs without one by logging the lead
# instead of emailing it (the durable Supabase row is unaffected either way).
RESEND_API_KEY=
# Optional — defaults to "Align the Spine Website <onboarding@resend.dev>".
LEAD_FROM_EMAIL=
# Optional — defaults to content/site.ts's siteConfig.business.email.
LEAD_TO_EMAIL=
# Optional — where failed-delivery operator alerts go (leadId only, never
# the submitted payload). Defaults to LEAD_TO_EMAIL if unset.
LEAD_ALERT_EMAIL=

# ATS-E5a: protects app/api/cron/retry-leads — required, no "open when
# unconfigured" fallback (that route mutates lead rows and sends email).
# Vercel automatically sends this as a Bearer token on cron-triggered
# requests once it's set in the project's env vars AND vercel.json declares
# the cron (already does) — you don't wire the header yourself. Generate
# any random secret, e.g. `openssl rand -hex 32`.
CRON_SECRET=
