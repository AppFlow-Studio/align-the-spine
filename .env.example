# Production origin used for canonical URLs, the sitemap, robots.txt, and
# JSON-LD. REQUIRED in production — content/site.ts's resolveSiteUrl() throws
# at module load if this is unset and VERCEL_ENV=production, rather than
# silently falling back to the wrong domain. Outside production (local dev,
# CI, preview builds without this set) it falls back to
# https://chirobackpain.com, this site's real domain — not the legacy
# alignthespinechiropractic.com site, which is a separate deployment.
SITE_URL=https://chirobackpain.com

# Google Search Console HTML-tag verification token (Settings > Ownership
# verification > HTML tag > content="..."). Optional — app/layout.tsx omits
# the verification meta tag entirely when this is unset, so it's safe to
# ship without one until marketing supplies it.
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). lib/analytics.ts's helpers no-op
# until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking — both required together to fire the
# "conversion" event on a lead submit (lib/analytics.ts's trackLeadConversion).
# Find these in Google Ads under Goals > Conversions > your conversion action
# > "Tag setup" > "Use Google tag" (ID is the AW-XXXXXXXXX value, label is
# the string after the slash in the provided send_to).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Enables Enhanced Conversions for Leads (sends a lead's email/phone to
# gtag.js's `user_data`, which Google hashes client-side before
# transmission — this codebase never hashes or stores the raw values).
# Turn this on only after enabling Enhanced Conversions for this conversion
# action in Google Ads (Conversions > your action > "Enhanced conversions" >
# "Google tag" method) — sending user_data before that is a harmless no-op,
# so there's no rush to flip this the moment it's added.
NEXT_PUBLIC_GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# The client's own Google Tag Manager container ID (e.g. GTM-XXXXXXX),
# installed verbatim per their install instructions — independent of the
# direct GA4/Ads gtag.js install above.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Lead CRM + transactional email (durable lead delivery platform)
# ---------------------------------------------------------------------------
# Put REAL values in .env.local (gitignored via `.env*` + `!.env.example`) —
# NEVER here. .env.example is a committed template; any value written here is
# published to the repo. None of the secrets below may take a NEXT_PUBLIC_
# prefix — that would ship them to the browser bundle.

# Resend transactional-email API key. The delivery worker
# (app/api/internal/deliver) uses it to send the office notification and the
# patient acknowledgment. Server-only. Leave blank in this template.
RESEND_API_KEY=

# Resend webhook signing secret (Resend Dashboard > Webhooks > your endpoint >
# "Signing Secret", starts with `whsec_`). /api/webhooks/resend verifies every
# inbound delivery/bounce/complaint event against it via svix. Server-only.
RESEND_WEBHOOK_SECRET=

# From / Reply-To for lead emails. `From` must be an address on a
# Resend-verified domain (chirobackpain.com). `Reply-To` must be a monitored,
# reply-capable mailbox (the Google Workspace inbox) — NOT a send-only address.
LEAD_EMAIL_FROM="Align the Spine Chiropractic <appointments@chirobackpain.com>"
LEAD_EMAIL_REPLY_TO=appointments@chirobackpain.com

# Where office lead notifications are delivered. In production the app fails
# closed on the office email (it still stores the lead) if this is unset.
# CC is optional (comma-separated for multiple).
LEAD_NOTIFICATION_TO=appointments@chirobackpain.com
LEAD_NOTIFICATION_CC=

# Sensitive-field email gate. When false — the default, and the value it falls
# back to when unset or malformed — the free-text `message` and `accidentDate`
# fields are NEVER decrypted into either email, template props, outbox JSON,
# logs, or error records. Do not flip to true until privacy/compliance sign-off.
LEAD_EMAIL_INCLUDE_SENSITIVE=false

# Supabase project that owns the lead CRM (durable storage + delivery outbox).
# A DEDICATED project for this site — not shared with any other application.
# The service-role key bypasses RLS and is server-only (never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key (base64) for AES-256-GCM encryption of sensitive lead fields
# (`message`, `accidentDate`) at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating/losing it makes previously-stored sensitive payloads unreadable;
# the lead row and all non-sensitive fields stay readable regardless.
LEAD_ENCRYPTION_KEY=

# Shared secret the delivery worker route requires in its Authorization header,
# so only the cron scheduler (or an authenticated admin retry) can drain the
# outbox. Server-only.
LEAD_DELIVERY_WORKER_SECRET=

# Password gate for /admin/leads. Server-only. The admin CRM view refuses to
# render without it, so leaving this blank keeps the route locked by default.
ADMIN_DASHBOARD_PASSWORD=