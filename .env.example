# Production origin used for canonical URLs, the sitemap, robots.txt, and
# JSON-LD. REQUIRED in production — content/site.ts's resolveSiteUrl() throws
# at module load if this is unset and VERCEL_ENV=production, rather than
# silently falling back to the wrong domain. Outside production (local dev,
# CI, preview builds without this set) it falls back to
# https://chirobackpain.com, this site's real domain — not the legacy
# alignthespinechiropractic.com site, which is a separate deployment.
SITE_URL=https://chirobackpain.com

# Google Search Console HTML-tag verification token (Settings > Ownership
# verification > HTML tag > content="..."). Optional — app/layout.tsx omits
# the verification meta tag entirely when this is unset, so it's safe to
# ship without one until marketing supplies it.
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). lib/analytics.ts's helpers no-op
# until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking — both required together to fire the
# "conversion" event on a lead submit (lib/analytics.ts's trackLeadConversion).
# Find these in Google Ads under Goals > Conversions > your conversion action
# > "Tag setup" > "Use Google tag" (ID is the AW-XXXXXXXXX value, label is
# the string after the slash in the provided send_to).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# The client's own Google Tag Manager container ID (e.g. GTM-XXXXXXX),
# installed verbatim per their install instructions — independent of the
# direct GA4/Ads gtag.js install above.
NEXT_PUBLIC_GTM_ID=

# Editorial content platform. Keep `fixture` for local/test builds unless a
# reviewed Supabase environment is intentionally connected.
CONTENT_REPOSITORY_MODE=fixture
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC, log them, or commit values.
# Rotate any privileged key disclosed through chat before use.
SUPABASE_SECRET_KEY=
CONTENT_REVALIDATION_SECRET=
CONTENT_PREVIEW_SIGNING_SECRET=
CRON_SECRET=

# First-party lead CRM. Fixture mode is local/test only. Supabase mode requires
# migrations 001-004 and a rotated server-only Supabase secret key.
LEAD_REPOSITORY_MODE=fixture
# 32 random bytes encoded as base64. Keep old key material during an approved
# key rotation until every retained payload has been re-encrypted.
LEAD_ENCRYPTION_KEY=
LEAD_ENCRYPTION_KEY_VERSION=1
# Independent HMAC secret used to pseudonymize request addresses for the
# database-backed hourly rate limit. Raw addresses are never stored.
LEAD_RATE_LIMIT_SECRET=
LEAD_RATE_LIMIT_PER_HOUR=10
LEAD_ALLOWED_ORIGINS=

# Outbox delivery. CRON_SECRET authorizes only /api/internal/lead-delivery.
LEAD_OUTBOX_STALE_SECONDS=300
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
# Server-only gate. Defaults to false (excluded) whenever unset or any value
# other than the literal string "true". When false, decrypted sensitive
# fields (message, accidentDate) never enter the Resend email body — only
# non-sensitive contact_fields and attribution do. Requires explicit
# privacy/compliance approval before setting to "true".
LEAD_EMAIL_INCLUDE_SENSITIVE=false
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Invisible Cloudflare Turnstile bot check on every /api/lead submission
# (dashboard.cloudflare.com > Turnstile > Add widget > mode "Invisible").
# Site key is public (safe in client JS); secret key is server-only. Both
# unset = the check is inert everywhere, including production — set both
# before relying on it. Cloudflare's public, always-pass TEST keys
# (1x00000000000000000000AA / 1x0000000000000000000000000000000AA) are
# safe to use for local dev before a real widget exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
