  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does an adjustment hurt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most patients feel pressure or a release, not pain \u2014 some soreness afterward is common, similar to starting a new stretch or exercise. We adjust our approach if anything feels off during your visit."
        }
      },
      {
        "@type": "Question",
        "name": "Is an adjustment safe after a car accident?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It may be appropriate after an evaluation rules out concerns that need imaging, urgent care, or referral. The first visit starts with an exam rather than assuming an adjustment is suitable."
        }
      },
      {
        "@type": "Question",
        "name": "How is an adjustment different from a massage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A massage works the soft tissue around a joint; an adjustment targets the joint itself \u2014 restoring motion to a segment that's stopped moving properly (a fixation), which is often the real source of the pain."
        }
      },
      {
        "@type": "Question",
        "name": "How many adjustments will I need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It depends on the condition, exam findings, and response to care. Dr. Abe reassesses progress instead of promising a fixed visit count or package upfront."
        }
      }
    ]
  }
